--- a/src/config.py
+++ b/src/config.py
@@ -201,4 +201,93 @@ PRINT_PROGRESS_EVERY  = 10
 # AUDIO CONFIGURATION
 # ============================================================================
 
-BACKGROUND_MUSIC_VOLUME = 0.044
\ No newline at end of file
+BACKGROUND_MUSIC_VOLUME = 0.044
+
+# ============================================================================
+# LANGUAGE SUPPORT
+# ============================================================================
+# Per-language MFA models + subtitle styling. Add a language = add a preset
+# here + (if its phone set isn't ARPABET) an IPA map below.
+#
+#   en : english_us_arpa dict + acoustic (ARPABET, PHONEME_MAP above)
+#   hi : hindi_cv dict + acoustic (Epitran IPA phone set, HINDI_PHONEME_MAP)
+#        Setup: mfa model download dictionary hindi_cv
+#               mfa model download acoustic  hindi_cv
+#               pip install epitran
+LANGUAGE_PRESETS = {
+    "en": {
+        "dictionary": "english_us_arpa",
+        "acoustic_model": "english_us_arpa",
+        "subtitle_font": "Arial",
+        "subtitle_upper": True,
+    },
+    "hi": {
+        "dictionary": "hindi_cv",
+        "acoustic_model": "hindi_cv",
+        # Needs a Devanagari font on the render box:
+        #   apt-get install -y fonts-noto-core   (Kaggle/Debian)
+        "subtitle_font": "Noto Sans Devanagari",
+        "subtitle_upper": False,
+    },
+}
+
+# Full hindi_cv phone inventory (Epitran) -> abstract mouth shape.
+# Mirrors the ARPABET choices in PHONEME_MAP so both languages animate alike:
+#   aa/ah/eh/ae/ao -> a | iy/ey -> ay | ow -> au | uw/uh/er/r/w -> u
+#   labials -> m | f/v -> f | coronal/velar/sibilant -> t | hh/l/y -> y
+HINDI_PHONEME_MAP = {
+    # open / central / open-mid vowels -> "a" arc
+    "a": "a", "aː": "a", "ɑ": "a", "ə": "a", "æ": "a", "æː": "a",
+    "ɛ": "a", "ʌ": "a", "ɔ": "a", "ɔː": "a", "ɪ": "a", "i": "a",
+    "ã": "a", "ãː": "a", "ə̃": "a",
+    # glides that narrow at the end -> "ay"
+    "iː": "ay", "e": "ay", "ẽ": "ay",
+    # o -> a-arc + u-arc
+    "o": "au",
+    # rounded -> "u"
+    "u": "u", "uː": "u", "ʊ": "u", "ũ": "u", "ũː": "u",
+    "r̩": "u", "ɹ̩": "u", "r": "u", "ɹ": "u", "ɽ": "u", "ɽ̥": "u", "w": "u",
+    # labials -> closed
+    "p": "m", "pʰ": "m", "b": "m", "b̤": "m", "m": "m",
+    # labiodental
+    "f": "f", "v": "f",
+    # coronal / dental / velar / palatal / sibilant / affricate -> teeth
+    "t": "t", "tʰ": "t", "d": "t", "d̤": "t",
+    "ʈ": "t", "ʈʰ": "t", "ɖ": "t", "ɖ̤": "t",
+    "k": "t", "kʰ": "t", "ɡ": "t", "ɡ̤": "t", "q": "t", "x": "t", "ɣ": "t",
+    "t͡ʃ": "t", "t͡ʃʰ": "t", "d͡ʒ": "t", "d͡ʒ̤": "t",
+    "n": "t", "ɳ": "t", "ɲ": "t", "ŋ": "t",
+    "s": "t", "z": "t", "ʃ": "t", "ʂ": "t", "θ": "t",
+    # glottal / lateral / palatal approximant -> narrow
+    "h": "y", "ɦ": "y", "l": "y", "j": "y",
+}
+
+# Phones the hindi_cv acoustic model knows. Used to filter Epitran G2P output
+# so generated pronunciations never introduce a phone the model lacks.
+HINDI_CV_PHONES = frozenset(HINDI_PHONEME_MAP)
+
+import unicodedata as _ud
+
+_IPA_MARKS_TO_STRIP = {"\u0361", "\u035c", "\u0324", "\u0325", "\u0329", "\u0303", "\u02b0", "\u02d0"}
+_PHONE_LOOKUP = {
+    _ud.normalize("NFC", k): v
+    for k, v in {**PHONEME_MAP, **HINDI_PHONEME_MAP}.items()
+}
+_WARNED_PHONES: set = set()
+
+
+def resolve_shape(phone: str):
+    """
+    Phone label -> abstract mouth shape. Handles ARPABET (en) and IPA (hi).
+    Order: exact (NFC) -> strip tie-bar/aspiration/length/nasal marks -> None.
+    Returns None for unknown phones so callers can warn instead of silently
+    closing the mouth.
+    """
+    p = _ud.normalize("NFC", phone.strip())
+    if p in _PHONE_LOOKUP:
+        return _PHONE_LOOKUP[p]
+    base = "".join(
+        c for c in _ud.normalize("NFD", p) if c not in _IPA_MARKS_TO_STRIP
+    )
+    base = _ud.normalize("NFC", base)
+    return _PHONE_LOOKUP.get(base)
